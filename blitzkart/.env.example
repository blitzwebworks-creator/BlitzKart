# Public Supabase values. The anon key is designed for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix service credentials with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Standard Checkout. Generate these in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=live

# PayU Hosted Checkout. Keep both merchant credentials server-side.
PAYU_KEY=
PAYU_SALT=
PAYU_ENVIRONMENT=live

# Public HTTPS BlitzKart URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional inventory alert default.
LOW_STOCK_DEFAULT=5