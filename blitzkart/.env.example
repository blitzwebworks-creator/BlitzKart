# Public Supabase values. The anon key is designed for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# UPI Gateway base URL, without a trailing slash; e.g. https://pay.example.in
UPI_GATEWAY_URL=
UPI_GATEWAY_API_KEY=
UPI_GATEWAY_API_SECRET=
UPI_GATEWAY_WEBHOOK_SECRET=
UPI_GATEWAY_ENVIRONMENT=live

# Must be HTTPS in production and allowlisted in UPI Gateway → Settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional operational threshold; inventory rows can also override per product.
LOW_STOCK_DEFAULT=5
