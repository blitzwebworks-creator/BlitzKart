# Public Supabase values. The anon key is designed for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix service credentials with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push for admin order, customer-request, and support alerts.
# Generate once with: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:blitzkart2026@gmail.com

# Razorpay Standard Checkout. Generate these in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=live

# PayU Hosted Checkout. Keep both merchant credentials server-side.
PAYU_KEY=
PAYU_SALT=
PAYU_ENVIRONMENT=live

# Optional WhatsApp Cloud API order alerts. Keep the access token server-side.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_ORDER_TEMPLATE=blitzkart_admin_new_order
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US

# Public HTTPS BlitzKart URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional inventory alert default.
LOW_STOCK_DEFAULT=5
